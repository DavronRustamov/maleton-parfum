# Shu fayldan nusxa olib ".env" deb nomlang va qiymatlarni to'ldiring.

# Sayt ishlaydigan port
PORT=3000

# Boshqaruv paneli paroli (bo'sh qoldirilsa, birinchi ishga tushirishda o'zi yaratiladi)
ADMIN_PASSWORD=

# @BotFather bergan bot tokeni
BOT_TOKEN=

# Buyurtmalar keladigan chat. Botga /id deb yozsangiz, shu raqamni aytadi
ADMIN_CHAT_ID=

# Saytning internetdagi manzili (https bilan). Botdagi "Katalogni ochish" tugmasi shuni ochadi
SITE_URL=

# Sotuvchining Telegram username'i (@ belgisisiz)
SELLER_USERNAME=maletonparfum
